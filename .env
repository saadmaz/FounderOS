# Google Calendar two-way sync (see src/lib/google-calendar/) - get the
# client ID/secret from Google Cloud Console > APIs & Services > Credentials
# (OAuth client ID > Web application), with this redirect URI added:
# https://work.saadmaz.com/api/integrations/google-calendar/callback
# Leave these unset to leave the integration inactive - the rest of the app
# works fine without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://work.saadmaz.com/api/integrations/google-calendar/callback
# Random secret we mint ourselves (e.g. `openssl rand -hex 32`) - verifies an
# incoming webhook POST actually came from the channel we registered.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=
# Protects /api/cron/* - Vercel automatically sends this as a Bearer header
# when the project has a CRON_SECRET env var set, so cron routes can check it.
CRON_SECRET=
