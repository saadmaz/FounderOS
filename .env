# Base environment config, committed to git and used by every deploy target
# (Vercel picks this up automatically at build time - no dashboard config
# needed). Safe to commit: these are public Firebase web config values,
# scoped by Firestore/Storage security rules, not secrets.
#
# For local development against the emulator instead of live Firebase,
# copy .env.local.example to .env.local - it overrides these values (Next.js
# loads .env first, then .env.local on top of it).

NEXT_PUBLIC_USE_EMULATOR=false

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDoAvXnwYqaR8jtnQYCSoIwyLHQZF_s9ss
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=founderos-saad.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=founderos-saad
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=founderos-saad.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=130398189283
NEXT_PUBLIC_FIREBASE_APP_ID=1:130398189283:web:ef216ef65d51357fe3f7d6
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-LY8N7NJ4NV

# Cloudinary - used for image uploads (company logos) instead of Firebase
# Storage. Safe to commit: an unsigned upload preset is a public-by-design
# value, not a secret - access is controlled by the preset's own settings
# in the Cloudinary dashboard (allowed formats, max file size, folder).
# See src/lib/cloudinary.ts. Fill these in after following the setup steps.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=rceonzjx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=founderos-logos
