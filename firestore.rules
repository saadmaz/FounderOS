rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function role(workspaceId) {
      return memberDoc(workspaceId).data.role;
    }

    // owner/admin/manager can manage structural data (companies, projects)
    function canManage(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'manager'];
    }

    // day-to-day contributors: everyone except viewer
    function canContribute(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) != 'viewer';
    }

    function isOwnerOrAdmin(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin'];
    }

    // financial data (expenses, revenue, invoices, budgets, vendors): the
    // dedicated 'accountant' role plus owner/admin. Managers/employees can
    // read for visibility but not write.
    function canManageFinance(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'accountant'];
    }

    // Points a signed-in user at their workspace(s); read/written by the
    // client during the first-login bootstrap flow (see ensureWorkspaceForUser).
    match /userWorkspaces/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwnerOrAdmin(workspaceId);

      match /members/{memberId} {
        allow read: if isMember(workspaceId);
        // Bootstrapping: the workspace creator may create their own owner membership.
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          request.resource.data.role == 'owner' &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;
        // Inviting others / changing roles is owner/admin only.
        allow create, update, delete: if isOwnerOrAdmin(workspaceId);
      }

      match /companies/{companyId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      match /projects/{projectId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      match /timeEntries/{entryId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Finance: expenses, revenue, invoices, budgets, vendors -----
      match /expenses/{expenseId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /revenue/{revenueId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /invoices/{invoiceId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /budgets/{budgetId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /vendors/{vendorId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /investments/{investmentId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      // ----- CRM: contacts, deals -----
      match /contacts/{contactId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      match /deals/{dealId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Documents -----
      match /documents/{documentId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Calendar -----
      match /calendarEvents/{eventId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Meetings -----
      match /meetings/{meetingId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Goals (structural/planning, like companies & projects) -----
      match /goals/{goalId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      // ----- Ideas -----
      match /ideas/{ideaId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Learning -----
      match /learningItems/{itemId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }
    }
  }
}
