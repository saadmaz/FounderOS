rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function role(workspaceId) {
      return memberDoc(workspaceId).data.role;
    }

    // owner/admin/manager can manage structural data (companies, projects)
    function canManage(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'manager'];
    }

    // day-to-day contributors: everyone except viewer
    function canContribute(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) != 'viewer';
    }

    function isOwnerOrAdmin(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin'];
    }

    // money members put in for companies (expenses, budgets, vendors,
    // investments): the dedicated 'accountant' role plus owner/admin.
    // Managers/employees can read for visibility but not write.
    function canManageFinance(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'accountant'];
    }

    // Points a signed-in user at their workspace(s); read/written by the
    // client during the first-login bootstrap flow (see ensureWorkspaceForUser).
    match /userWorkspaces/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Invites: top-level (not nested under /workspaces) so an invitee who
    // isn't a member yet - or isn't even signed in yet - can still load the
    // invite page. The doc id is a random, unguessable Firestore auto-id and
    // that's the real security boundary here: `get` is intentionally public
    // (single doc, by exact known id), but `list` is restricted so invites
    // can't be enumerated. Acceptance itself happens server-side via Firebase
    // Admin (see src/app/api/workspace/accept-invite), not a client update -
    // rules can only authorize by exact document path, and there's no path
    // this rule could look up to confirm "a pending invite exists for this
    // caller's email" without the invite id already known.
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if isOwnerOrAdmin(resource.data.workspaceId);
      allow create: if isOwnerOrAdmin(request.resource.data.workspaceId) &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Revoke only.
      allow update, delete: if isOwnerOrAdmin(resource.data.workspaceId);
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwnerOrAdmin(workspaceId);

      match /members/{memberId} {
        allow read: if isMember(workspaceId);
        // Bootstrapping: the workspace creator may create their own owner membership.
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          request.resource.data.role == 'owner' &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;
        // Accepting an invite happens server-side via Firebase Admin (see
        // src/app/api/workspace/accept-invite), which bypasses these rules
        // entirely - there's no client-write path for a brand-new member to
        // create their own non-owner doc.
        // Adding/editing/removing others is owner/admin only, and can never
        // touch the owner role - no demoting, removing, or newly assigning
        // it through this UI (no owner transfer in this pass).
        allow create: if isOwnerOrAdmin(workspaceId) && request.resource.data.role != 'owner';
        // request.resource is null on delete - keep it out of that branch
        // entirely rather than referencing it in a combined update+delete
        // condition, which would make every delete fail closed.
        allow update: if isOwnerOrAdmin(workspaceId) &&
          resource.data.role != 'owner' &&
          (!('role' in request.resource.data) || request.resource.data.role != 'owner');
        allow delete: if isOwnerOrAdmin(workspaceId) && resource.data.role != 'owner';
      }

      match /companies/{companyId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      match /projects/{projectId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      match /timeEntries/{entryId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Time off: days marked as not-working for a "work" company -----
      match /timeOff/{entryId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Finance: money members put in on a company's behalf
      // (expenses, budgets, vendors, investments) - not the company's own
      // revenue/client invoicing, which lives in a different system. -----
      match /expenses/{expenseId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /budgets/{budgetId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /vendors/{vendorId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      match /investments/{investmentId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManageFinance(workspaceId);
      }

      // ----- CRM: contacts, deals -----
      match /contacts/{contactId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      match /contactActivity/{activityId} {
        allow read: if isMember(workspaceId);
        allow create, delete: if canContribute(workspaceId);
      }

      match /deals/{dealId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // Flat like every other collection here (see documents/companyId)
      // rather than nested under /deals/{dealId} - keeps every collection
      // one level deep under the workspace, filtered by a plain field.
      match /dealActivity/{activityId} {
        allow read: if isMember(workspaceId);
        allow create, delete: if canContribute(workspaceId);
      }

      // ----- Documents -----
      match /documents/{documentId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // Flat like contactActivity/dealActivity above - a company's dated
      // notes, filtered by companyId rather than nested under /companies.
      match /companyNotes/{noteId} {
        allow read: if isMember(workspaceId);
        allow create, delete: if canContribute(workspaceId);
      }

      // ----- Calendar -----
      match /calendarEvents/{eventId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Meetings -----
      match /meetings/{meetingId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Goals (structural/planning, like companies & projects) -----
      match /goals/{goalId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canManage(workspaceId);
      }

      // Append-only progress-history log for goals (see GoalProgressEntry) -
      // flat, filtered by goalId, same convention as dealActivity/
      // contactActivity. No update/delete: it's a log, not editable state.
      match /goalProgress/{entryId} {
        allow read: if isMember(workspaceId);
        allow create: if canManage(workspaceId);
      }

      // ----- Ideas -----
      match /ideas/{ideaId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }

      // ----- Learning -----
      match /learningItems/{itemId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if canContribute(workspaceId);
      }
    }
  }
}
