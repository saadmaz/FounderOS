[debug] [2026-07-28T06:26:33.480Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-founderos:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function memberDoc(workspaceId) {\n      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));\n    }\n\n    function isMember(workspaceId) {\n      return isSignedIn() &&\n        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));\n    }\n\n    function role(workspaceId) {\n      return memberDoc(workspaceId).data.role;\n    }\n\n    // owner/admin/manager can manage structural data (companies, projects)\n    function canManage(workspaceId) {\n      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'manager'];\n    }\n\n    // day-to-day contributors: everyone except viewer\n    function canContribute(workspaceId) {\n      return isMember(workspaceId) && role(workspaceId) != 'viewer';\n    }\n\n    function isOwnerOrAdmin(workspaceId) {\n      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin'];\n    }\n\n    // Points a signed-in user at their workspace(s); read/written by the\n    // client during the first-login bootstrap flow (see ensureWorkspaceForUser).\n    match /userWorkspaces/{uid} {\n      allow read, write: if isSignedIn() && request.auth.uid == uid;\n    }\n\n    match /workspaces/{workspaceId} {\n      allow read: if isMember(workspaceId);\n      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;\n      allow update, delete: if isOwnerOrAdmin(workspaceId);\n\n      match /members/{memberId} {\n        allow read: if isMember(workspaceId);\n        // Bootstrapping: the workspace creator may create their own owner membership.\n        allow create: if isSignedIn() && request.auth.uid == memberId &&\n          request.resource.data.role == 'owner' &&\n          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;\n        // Inviting others / changing roles is owner/admin only.\n        allow create, update, delete: if isOwnerOrAdmin(workspaceId);\n      }\n\n      match /companies/{companyId} {\n        allow read: if isMember(workspaceId);\n        allow create, update, delete: if canManage(workspaceId);\n      }\n\n      match /projects/{projectId} {\n        allow read: if isMember(workspaceId);\n        allow create, update, delete: if canManage(workspaceId);\n      }\n\n      match /tasks/{taskId} {\n        allow read: if isMember(workspaceId);\n        allow create, update, delete: if canContribute(workspaceId);\n      }\n\n      match /timeEntries/{entryId} {\n        allow read: if isMember(workspaceId);\n        allow create, update, delete: if canContribute(workspaceId);\n      }\n    }\n  }\n}\n"}]}}
