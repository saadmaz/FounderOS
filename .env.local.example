# Copy this file to .env.local
#
# For local development against the Firebase Emulator Suite, these dummy
# values are fine as-is - NEXT_PUBLIC_FIREBASE_PROJECT_ID must match the
# "default" project in .firebaserc ("demo-founderos"). No real Firebase
# project is required until you're ready to go live.
#
# To point this app at a real Firebase project instead:
#   1. Create a project at https://console.firebase.google.com
#   2. Enable Authentication (Email/Password + Google), Firestore, and Storage
#   3. Project settings > General > Your apps > Web app > copy the config below
#   4. Set NEXT_PUBLIC_USE_EMULATOR=false

NEXT_PUBLIC_USE_EMULATOR=true

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-founderos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-founderos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-founderos.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
