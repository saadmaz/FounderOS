# .env already has real founderos-saad config committed at the repo root,
# used by default for both `npm run dev` and every deploy target.
#
# Copy this file to .env.local to opt OUT of that and develop against the
# local Firebase Emulator Suite instead - these dummy values are fine as-is,
# and Next.js loads .env.local on top of .env, overriding it.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID must match the "default" project in
# .firebaserc ("demo-founderos").

NEXT_PUBLIC_USE_EMULATOR=true

# Used to build the links inside emails we send ourselves (password reset,
# email verification). Defaults to localhost if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-founderos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-founderos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-founderos.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional: only needed if Analytics is enabled on the Firebase app.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudinary - only needed to test uploads locally; see .env for setup notes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_DOCS_UPLOAD_PRESET=

# Real secrets (used server-side only, by src/app/api/documents/delete) -
# this is exactly why these two don't have the NEXT_PUBLIC_ prefix. Get them
# from the Cloudinary dashboard: Settings > API Keys. Never put these in the
# committed .env file.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email - see src/lib/email/) - get an API key at
# resend.com > API Keys. RESEND_FROM_EMAIL needs a domain verified in Resend
# to send to arbitrary recipients; leave blank to use Resend's shared
# sandbox sender, which only delivers to your own Resend account's email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase Admin (server-only - see src/lib/firebase/admin.ts) - generates
# the password-reset/email-verification links we email via Resend instead
# of Firebase's built-in sender. Get these from Firebase Console > Project
# Settings > Service Accounts > Generate new private key. Grants full admin
# access to the project - never commit it.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
